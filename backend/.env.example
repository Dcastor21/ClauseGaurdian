# FILE: .env.example | PURPOSE: Template for all required environment variables | CONNECTS TO: app/config.py reads these via pydantic-settings
#
# HOW TO USE:
#   cp .env.example .env
#   Fill in each value — NEVER commit the filled .env to git
#   .env is in .gitignore — this .env.example is safe to commit

# ── CLERK ─────────────────────────────────────────────────────────────────────
# Find at: Clerk Dashboard → API Keys → Secret Keys
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# Find at: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
# (create the endpoint first, then copy this value)
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Find at: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://REPLACE_ME.supabase.co

# Find at: Supabase Dashboard → Settings → API → anon public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Find at: Supabase Dashboard → Settings → API → service_role secret
# DANGER: never expose this key — it bypasses all Row Level Security
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ── LLM ───────────────────────────────────────────────────────────────────────
# Find at: openrouter.ai → Keys → Create Key
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Find at: helicone.ai → Settings → API Keys → Create API Key
HELICONE_API_KEY=sk-helicone-REPLACE_ME

# ── ALERTS ────────────────────────────────────────────────────────────────────
# Find at: resend.com → API Keys → Create API Key
RESEND_API_KEY=re_REPLACE_ME

# Your Ntfy.sh topic name (not a secret — just keep it hard to guess)
# Example: my-clauseguardian-alerts-abc123
NTFY_TOPIC=REPLACE_ME

# ── RATE LIMITING ─────────────────────────────────────────────────────────────
# Find at: Upstash Console → your database → REST API → REST URL
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io

# Find at: Upstash Console → your database → REST API → REST Token
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ── MONITORING ────────────────────────────────────────────────────────────────
# Find at: Sentry → Project Settings → Client Keys (DSN) → Show DSN
# Leave empty to disable Sentry (safe during early development)
SENTRY_DSN=

# ── APP ───────────────────────────────────────────────────────────────────────
# development | staging | production
# Controls: log level (debug vs info), whether /docs UI is exposed
ENVIRONMENT=development
